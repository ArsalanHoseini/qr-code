{
    "name": "local/qr-manager",
    "description": "سامانه فارسی مدیریت کدهای QR",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-gd": "*",
        "endroid/qr-code": "6.0.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "require-dev": {
        "khanamiryan/qrcode-detector-decoder": "^2.0.3",
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit --colors=always"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.6"
        }
    }
}
